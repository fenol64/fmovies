# Banco usado pelo docker compose. Dentro do container a URL é sobrescrita.
DATABASE_URL=postgresql://fmovies:fmovies@db:5432/fmovies

# Segredo da sessão. Troque por uma string longa e aleatória.
AUTH_SECRET=troque-por-um-segredo-longo

# URL pública da aplicação.
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Token de leitura do TMDB (API Read Access Token), não a chave curta v3.
# https://www.themoviedb.org/settings/api
TMDB_ACCESS_TOKEN=

# Chave do TasteDive.
# https://tastedive.com/account/api_access
TASTEDIVE_API_KEY=
